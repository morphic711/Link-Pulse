# Copy this file to .env, then replace this placeholder with the Supabase session pooler URI.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@YOUR_SESSION_POOLER_HOST:5432/postgres

# Use a long, private random value for Flask sessions and CSRF tokens.
SECRET_KEY=replace-with-a-long-random-secret

# Keep false for local HTTP development; set true after deployment uses HTTPS.
SESSION_COOKIE_SECURE=false
